---
/**
 * Composant ObjectiveList — liste d'objectifs pédagogiques avec coches.
 *
 * Utilisation :
 *   <ObjectiveList items={[
 *     'Comprendre la différence entre RAM et stockage',
 *     'Naviguer dans le système de fichiers en ligne de commande',
 *     'Écrire un script shell de base'
 *   ]} />
 */

interface Props {
  items: string[];
  title?: string;
}

const { items, title = 'À l\'issue de cet axe, tu sauras :' } = Astro.props;
---

<div class="objective-block">
  <p class="objective-title">{title}</p>
  <ul class="objectives">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .objective-block {
    background: var(--sl-color-bg-nav);
    border-left: 3px solid var(--sl-color-accent);
    padding: 1rem 1.25rem;
    border-radius: 0 0.375rem 0.375rem 0;
    margin: 1.25rem 0;
  }
  .objective-title {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
</style>
