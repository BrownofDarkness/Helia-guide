---
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
import ProgressTracker from './ProgressTracker.astro';
import CommandPalette from './CommandPalette.astro';
import PersonaSwitcher from './PersonaSwitcher.astro';
---

<Default><slot /></Default>
<ClientRouter />

<!--
  Anti-flash blanc à la navigation :
  meta color-scheme indique au browser de respecter le mode système
  pour les éléments natifs (scrollbars, focus rings, bg par défaut).
  Le style inline force le bg color de <html> dès le 1er paint, avant
  même que le CSS externe n'arrive. Couvre les 3 cas : auto, light, dark.
-->
<meta name="color-scheme" content="light dark" />
<style is:inline>
  html { background-color: #0a0a0d; color: #ffffff; }
  @media (prefers-color-scheme: light) {
    html { background-color: #ffffff; color: #0a0a0d; }
  }
  html[data-theme='light'] { background-color: #ffffff; color: #0a0a0d; }
  html[data-theme='dark']  { background-color: #0a0a0d; color: #ffffff; }
</style>

<!--
  Critical CSS inline (anti-FOUC) — positionne immédiatement les triggers
  flottants Cmd+K et persona-switcher pour éviter qu'ils apparaissent
  en haut-gauche (flux par défaut) avant que le CSS principal n'arrive.
  Caché par défaut, révélé quand le CSS principal a chargé via une transition opacity.
-->
<style is:inline>
  #cmdk-trigger,
  #persona-switcher {
    position: fixed;
    right: 1.25rem;
    z-index: 50;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  #cmdk-trigger { bottom: 1.25rem; }
  #persona-switcher { bottom: 4.25rem; z-index: 49; }
  /* Une fois le CSS principal chargé, .cmdk-loaded est ajouté à <html>
     et révèle les triggers. */
  html.cmdk-loaded #cmdk-trigger,
  html.cmdk-loaded #persona-switcher { opacity: 1; }
</style>
<script is:inline>
  // Marque la racine comme "CSS chargé" dès que le DOM est prêt.
  // L'attribut hidden initial évite le FOUC, le fade-in fait le reste.
  if (document.readyState !== 'loading') {
    document.documentElement.classList.add('cmdk-loaded');
  } else {
    document.addEventListener('DOMContentLoaded', () => {
      document.documentElement.classList.add('cmdk-loaded');
    });
  }
</script>

<ProgressTracker />
<CommandPalette />
<PersonaSwitcher />
