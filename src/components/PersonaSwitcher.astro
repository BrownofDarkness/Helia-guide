---
/**
 * Persona switcher — bouton flottant + popover pour changer de parcours fil rouge
 * sans devoir naviguer vers le préambule.
 *
 * Compatible avec le ScenarioPicker existant (mêmes localStorage + data-parcours
 * sur <html>). Émet un event `guide-parcours-change` pour la synchronisation.
 */
import PersonaAvatar from './PersonaAvatar.astro';

type Persona = { value: 'A' | 'B' | 'C' | 'D' | 'E'; initial: string; name: string; subtitle: string };

const personas: Persona[] = [
  { value: 'A', initial: 'M', name: 'Marie', subtitle: 'La Boulangerie de Lina' },
  { value: 'B', initial: 'H', name: 'Hugo', subtitle: 'Studio Pulse' },
  { value: 'C', initial: 'S', name: 'Sami', subtitle: 'GreenBox' },
  { value: 'D', initial: 'L', name: 'Léa', subtitle: 'CoupDeMain' },
  { value: 'E', initial: 'Y', name: 'Yanis', subtitle: 'Tasky' },
];
---

<div class="persona-switcher" id="persona-switcher">
  <button
    type="button"
    class="persona-trigger"
    id="persona-trigger"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="Changer de parcours fil rouge"
  >
    <span class="persona-trigger-avatar empty" id="persona-trigger-avatar" aria-hidden="true">?</span>
    <span class="persona-trigger-label" id="persona-trigger-label">Aucun parcours</span>
    <svg class="persona-caret" viewBox="0 0 16 16" width="10" height="10" aria-hidden="true">
      <path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" />
    </svg>
  </button>

  <div class="persona-popover" id="persona-popover" role="dialog" aria-label="Choisir un parcours" hidden>
    <h3 class="persona-popover-title">Parcours fil rouge</h3>
    <ul class="persona-list">
      {personas.map((p) => (
        <li>
          <button type="button" class="persona-option" data-parcours={p.value}>
            <PersonaAvatar parcours={p.value} initial={p.initial} size={40} label={`Avatar de ${p.name}`} />
            <span class="persona-option-content">
              <strong>{p.name}</strong>
              <small>{p.subtitle}</small>
            </span>
          </button>
        </li>
      ))}
      <li class="persona-list-separator" aria-hidden="true"></li>
      <li>
        <button type="button" class="persona-option persona-none" data-parcours="">
          <span class="persona-none-icon" aria-hidden="true">✕</span>
          <span class="persona-option-content">
            <strong>Aucun parcours</strong>
            <small>Cacher tous les scénarios fil rouge</small>
          </span>
        </button>
      </li>
    </ul>
  </div>
</div>

<style>
  .persona-switcher {
    position: fixed;
    bottom: 4.25rem;
    right: 1.25rem;
    z-index: 49;
  }

  .persona-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.7rem 0.3rem 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7, var(--sl-color-bg));
    color: inherit;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    transition: border-color 120ms ease, color 120ms ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  .persona-trigger:hover {
    border-color: var(--sl-color-accent);
  }

  .persona-trigger-avatar {
    display: inline-flex;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 0.78rem;
    flex-shrink: 0;
  }
  .persona-trigger-avatar.empty {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }
  .persona-trigger-avatar[data-parcours='A'] { background: var(--parcours-A-color); }
  .persona-trigger-avatar[data-parcours='B'] { background: var(--parcours-B-color); }
  .persona-trigger-avatar[data-parcours='C'] { background: var(--parcours-C-color); }
  .persona-trigger-avatar[data-parcours='D'] { background: var(--parcours-D-color); }
  .persona-trigger-avatar[data-parcours='E'] { background: var(--parcours-E-color); }

  .persona-caret {
    opacity: 0.5;
    flex-shrink: 0;
  }

  .persona-popover {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    right: 0;
    min-width: 300px;
    padding: 0.5rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.7rem;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.28);
    animation: personaPopoverIn 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes personaPopoverIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .persona-popover-title {
    margin: 0;
    padding: 0.45rem 0.6rem 0.55rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-2);
    font-weight: 600;
  }

  .persona-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .persona-list-separator {
    height: 1px;
    background: var(--sl-color-gray-5);
    margin: 0.4rem 0;
  }

  .persona-option {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.6rem;
    background: none;
    border: 1px solid transparent;
    border-radius: 0.45rem;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-align: left;
    transition: background 100ms ease, border-color 100ms ease;
  }
  .persona-option:hover {
    background: var(--sl-color-accent-low);
  }
  .persona-option.is-current {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }

  .persona-none-icon {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: 1.1rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .persona-option-content {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    flex: 1;
    min-width: 0;
  }
  .persona-option-content strong {
    font-weight: 600;
    font-size: 0.92rem;
  }
  .persona-option-content small {
    font-size: 0.78rem;
    color: var(--sl-color-gray-2);
    margin-top: 0.05rem;
  }
  .persona-option.is-current .persona-option-content small {
    color: inherit;
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .persona-trigger-label { display: none; }
    .persona-trigger { padding: 0.3rem; }
    .persona-popover { min-width: 260px; }
  }
</style>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'fil-rouge';
    const PERSONAS = {
      A: { initial: 'M', name: 'Marie' },
      B: { initial: 'H', name: 'Hugo' },
      C: { initial: 'S', name: 'Sami' },
      D: { initial: 'L', name: 'Léa' },
      E: { initial: 'Y', name: 'Yanis' },
    };

    function readParcours() {
      try {
        const v = localStorage.getItem(STORAGE_KEY);
        return v && PERSONAS[v] ? v : '';
      } catch { return ''; }
    }

    function applyParcours(value) {
      try {
        if (value && PERSONAS[value]) {
          localStorage.setItem(STORAGE_KEY, value);
          document.documentElement.dataset.parcours = value;
        } else {
          localStorage.removeItem(STORAGE_KEY);
          delete document.documentElement.dataset.parcours;
        }
      } catch {}
      syncUI();
      // Notifie ScenarioPicker et autres listeners
      document.dispatchEvent(new CustomEvent('guide-parcours-change', { detail: { value } }));
    }

    function syncUI() {
      const current = readParcours();

      // Trigger button
      const avatarEl = document.getElementById('persona-trigger-avatar');
      const labelEl = document.getElementById('persona-trigger-label');
      if (avatarEl && labelEl) {
        if (current) {
          const p = PERSONAS[current];
          avatarEl.dataset.parcours = current;
          avatarEl.classList.remove('empty');
          avatarEl.textContent = p.initial;
          labelEl.textContent = p.name;
        } else {
          avatarEl.removeAttribute('data-parcours');
          avatarEl.classList.add('empty');
          avatarEl.textContent = '?';
          labelEl.textContent = 'Aucun parcours';
        }
      }

      // Options du popover
      document.querySelectorAll('.persona-option').forEach((el) => {
        el.classList.toggle('is-current', (el.dataset.parcours || '') === current);
      });

      // Sync les .picker-card du ScenarioPicker éventuellement présentes
      document.querySelectorAll('.picker-card').forEach((c) => {
        const match = (c.dataset.parcours || '') === current;
        c.classList.toggle('chosen', match);
        c.setAttribute('aria-pressed', String(match));
      });
    }

    function closePopover() {
      const popover = document.getElementById('persona-popover');
      const trigger = document.getElementById('persona-trigger');
      if (popover && !popover.hidden) {
        popover.hidden = true;
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
      }
    }

    // Délégation globale (idempotent)
    if (!document.body.dataset.personaDelegated) {
      document.body.dataset.personaDelegated = '1';

      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;

        const trigger = target.closest('#persona-trigger');
        if (trigger) {
          const popover = document.getElementById('persona-popover');
          if (popover) {
            const wasOpen = !popover.hidden;
            popover.hidden = wasOpen;
            trigger.setAttribute('aria-expanded', String(!wasOpen));
          }
          return;
        }

        const option = target.closest('.persona-option');
        if (option) {
          applyParcours(option.dataset.parcours || '');
          closePopover();
          return;
        }

        // Click outside ferme
        const popover = document.getElementById('persona-popover');
        if (popover && !popover.hidden && !popover.contains(target)) {
          closePopover();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closePopover();
      });

      // Sync quand le ScenarioPicker change le parcours de son côté
      document.addEventListener('guide-parcours-change', syncUI);
    }

    function init() { syncUI(); }
    init();
    document.addEventListener('astro:page-load', init);
    document.addEventListener('astro:after-swap', init);
  })();
</script>
