---
/**
 * Override du Footer Starlight :
 * - Conserve la pagination prev/next + meta (last updated, edit link)
 * - Ajoute un footer global Helia en dessous (style minimal Linear/Vercel)
 */
import Default from '@astrojs/starlight/components/Footer.astro';

const year = new Date().getFullYear();

const NAV = [
  { href: '/00-preambule/', label: 'Préambule' },
  { href: '/glossaire/', label: 'Glossaire' },
  { href: '/pieges/', label: 'Pièges' },
  { href: '/fil-rouge/', label: 'Fil rouge' },
];

const SOCIAL = [
  {
    href: 'https://github.com/BrownofDarkness/Helia-guide',
    label: 'GitHub',
    external: true,
    icon: 'github',
  },
  {
    href: 'https://x.com/BrownofDarkness',
    label: 'Twitter / X',
    external: true,
    icon: 'x',
  },
  {
    href: '/a-propos/',
    label: 'À propos',
    external: false,
    icon: 'about',
  },
];
---

<Default><slot /></Default>

<footer class="helia-footer" role="contentinfo">
  <div class="helia-footer-brand">
    <img src="/favicon.svg?v=2" alt="" width="22" height="22" class="helia-footer-logo" />
    <div class="helia-footer-brand-text">
      <strong>Helia</strong>
      <span>Guide francophone du développeur web</span>
    </div>
  </div>

  <nav class="helia-footer-nav" aria-label="Liens utiles">
    {NAV.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>

  <nav class="helia-footer-social" aria-label="Liens sociaux et à propos">
    {SOCIAL.map((s) => (
      <a
        href={s.href}
        aria-label={s.label}
        title={s.label}
        target={s.external ? '_blank' : undefined}
        rel={s.external ? 'noopener noreferrer' : undefined}
      >
        {s.icon === 'github' && (
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.16-.02-2.11-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.97 10.97 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56C20.21 21.39 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
          </svg>
        )}
        {s.icon === 'x' && (
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z"/>
          </svg>
        )}
        {s.icon === 'about' && (
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
        )}
      </a>
    ))}
  </nav>

  <div class="helia-footer-meta">
    © {year} Helia · Construit avec <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> + <a href="https://starlight.astro.build" target="_blank" rel="noopener">Starlight</a>
  </div>
</footer>

<style>
  .helia-footer {
    margin-top: 3rem;
    padding: 1.5rem 0 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
  }

  .helia-footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .helia-footer-logo {
    flex-shrink: 0;
    border-radius: 4px;
  }
  .helia-footer-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .helia-footer-brand-text strong {
    color: var(--sl-color-text);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .helia-footer-brand-text span {
    font-size: 0.78rem;
  }

  .helia-footer-nav {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    flex: 1;
    justify-content: center;
  }
  .helia-footer-nav a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .helia-footer-nav a:hover {
    color: var(--sl-color-accent);
  }

  .helia-footer-social {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .helia-footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 0.4rem;
    color: var(--sl-color-gray-2);
    transition: color 120ms ease, background 120ms ease;
  }
  .helia-footer-social a:hover {
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .helia-footer-meta {
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
    flex-shrink: 0;
    text-align: end;
  }
  .helia-footer-meta a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .helia-footer-meta a:hover {
    color: var(--sl-color-accent);
  }

  @media (max-width: 720px) {
    .helia-footer {
      flex-direction: column;
      align-items: flex-start;
      text-align: start;
    }
    .helia-footer-nav { justify-content: flex-start; }
    .helia-footer-meta { text-align: start; }
  }
</style>
